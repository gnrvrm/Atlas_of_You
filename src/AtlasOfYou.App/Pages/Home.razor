@page "/"
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>Atlas of You</PageTitle>

<main class="app-shell">
    <header class="topbar">
        <div class="brand">
            <h1>Atlas of You</h1>
            <span class="badge">v0.5.0 · Atlas kartı</span>
        </div>
        <div class="privacy-note">Girdiğin bilgiler tarayıcıda kalır; hesap veya backend yok.</div>
    </header>

    <section class="workspace">
        <aside class="input-panel" aria-label="Profil bilgileri">
            <h2 class="panel-title">Profil</h2>

            @if (loadError is not null)
            {
                <div class="error">@loadError</div>
            }
            else
            {
                <div class="form-grid">
                    <label class="field">
                        <span>Ülke</span>
                        <select class="select" aria-label="Ülke" @bind="selectedCountryIso">
                            @foreach (var country in Countries)
                            {
                                <option value="@country.Iso">@country.Name</option>
                            }
                        </select>
                    </label>

                    <div class="field">
                        <span>Cinsiyet referansı</span>
                        <div class="segmented">
                            <label>
                                <input type="radio" name="sex" checked='@(selectedSex == "male")' @onchange='@(() => selectedSex = "male")' />
                                <span>Erkek</span>
                            </label>
                            <label>
                                <input type="radio" name="sex" checked='@(selectedSex == "female")' @onchange='@(() => selectedSex = "female")' />
                                <span>Kadın</span>
                            </label>
                        </div>
                    </div>

                    <label class="field">
                        <span>Doğum yılı</span>
                        <input class="input" aria-label="Doğum yılı" type="number" min="1896" max="@MaxBirthYear" @bind="birthYear" @bind:event="oninput" />
                    </label>

                    <label class="field">
                        <span>Boy (cm)</span>
                        <input class="input" aria-label="Boy (cm)" type="number" min="120" max="230" step="0.1" @bind="heightCm" @bind:event="oninput" />
                    </label>

                    <label class="field">
                        <span>Kilo (kg)</span>
                        <input class="input" aria-label="Kilo (kg)" type="number" min="35" max="250" step="0.1" @bind="weightKg" @bind:event="oninput" />
                    </label>

                    <label class="field">
                        <span>Göz rengi</span>
                        <select class="select" aria-label="Göz rengi" @bind="selectedEyeColor">
                            @foreach (var option in EyeColorOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </label>

                    <label class="field">
                        <span>Saç rengi</span>
                        <select class="select" aria-label="Saç rengi" @bind="selectedHairColor">
                            @foreach (var option in HairColorOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </label>

                    <label class="field">
                        <span>El tercihi</span>
                        <select class="select" aria-label="El tercihi" @bind="selectedHandPreference">
                            @foreach (var option in HandPreferenceOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </label>

                    <label class="field">
                        <span>Kan grubu</span>
                        <select class="select" aria-label="Kan grubu" @bind="selectedBloodGroup">
                            @foreach (var option in BloodGroupOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </label>

                    @if (formError is not null)
                    {
                        <div class="error">@formError</div>
                    }

                    <button class="primary-action" type="button" @onclick="AnalyzeProfileAsync" disabled="@(dataset is null || isAnalyzing)">
                        @(isAnalyzing ? "Hazırlanıyor..." : "Karşılaştır")
                    </button>
                </div>
            }

            @if (result is not null)
            {
                <section class="body-atlas" aria-label="Vücut atlası">
                    <div class="body-atlas-header">
                        <h2>Vücut atlası</h2>
                        <span>3D ölçekli görünüm</span>
                    </div>

                    <div class="body-visual-shell" role="img" aria-label="Sen ve ülke ortalaması 3D vücut karşılaştırması">
                        <canvas @ref="bodyCanvas" class="@BodyCanvasClass" aria-hidden="true"></canvas>

                        @if (!bodySceneRequested)
                        {
                            <div class="scene-lazy-panel">
                                <strong>Hızlı açılış modu</strong>
                                <span>3D sahne ayrı yüklenir.</span>
                                <button class="copy-action" type="button" @onclick="StartBodySceneAsync" disabled="@isBodySceneStarting">
                                    @(isBodySceneStarting ? "3D hazırlanıyor..." : "3D sahneyi başlat")
                                </button>
                            </div>
                        }

                        <div class="scene-overlay">
                            <span class="scene-pill average-pill">Ülke ort. @FormatCm(result.CountryMeanHeightCm)</span>
                            <span class="scene-pill user-pill">Sen @FormatCm(heightCm)</span>
                        </div>

                        <div class="scene-hotspots" aria-label="3D bilgi bölgeleri">
                            <button class="@SceneHotspotClass("height")" type="button" @onclick='@(() => SetSceneInsight("height"))' aria-label="Boy karşılaştırmasını göster">Boy</button>
                            <button class="@SceneHotspotClass("body")" type="button" @onclick='@(() => SetSceneInsight("body"))' aria-label="BMI referansını göster">BMI</button>
                            <button class="@SceneHotspotClass("hair")" type="button" @onclick='@(() => SetSceneInsight("hair"))' aria-label="Saç rengi yaygınlığını göster">Saç</button>
                            <button class="@SceneHotspotClass("eye")" type="button" @onclick='@(() => SetSceneInsight("eye"))' aria-label="Göz rengi yaygınlığını göster">Göz</button>
                            <button class="@SceneHotspotClass("hand")" type="button" @onclick='@(() => SetSceneInsight("hand"))' aria-label="El tercihi yaygınlığını göster">El</button>
                            <button class="@SceneHotspotClass("blood")" type="button" @onclick='@(() => SetSceneInsight("blood"))' aria-label="Kan grubu yaygınlığını göster">Kan</button>
                        </div>

                        @if (bodySceneError is not null)
                        {
                            <div class="scene-error">@bodySceneError</div>
                        }
                    </div>

                    <article class="scene-insight" style="@SelectedSceneInsightStyle">
                        <span>@SelectedSceneInsightKicker</span>
                        <strong>@SelectedSceneInsightTitle</strong>
                        <p>@SelectedSceneInsightText</p>
                        <small>@SelectedSceneInsightMeta</small>
                    </article>

                    <div class="body-stat-grid">
                        <div>
                            <span>Boy farkı</span>
                            <strong>@FormatSignedCm(result.CountryHeightDifferenceCm)</strong>
                        </div>
                        <div>
                            <span>Kilo farkı</span>
                            <strong>@FormatSignedKg(result.CountryWeightDifferenceKg)</strong>
                        </div>
                    </div>

                    <div class="trait-slots" aria-label="Görsel özellik alanları">
                        <span style="@TraitAccentStyle(result.HairColor)">
                            <small>Saç</small>
                            <strong>@TraitLabel(result.HairColor)</strong>
                        </span>
                        <span style="@TraitAccentStyle(result.EyeColor)">
                            <small>Göz</small>
                            <strong>@TraitLabel(result.EyeColor)</strong>
                        </span>
                        <span style="@TraitAccentStyle(result.HandPreference)">
                            <small>El</small>
                            <strong>@TraitLabel(result.HandPreference)</strong>
                        </span>
                        <span style="@TraitAccentStyle(result.BloodGroup)">
                            <small>Kan</small>
                            <strong>@TraitLabel(result.BloodGroup)</strong>
                        </span>
                    </div>
                </section>
            }
        </aside>

        <section class="result-panel" aria-live="polite">
            @if (dataset is null && loadError is null)
            {
                <div class="loading-state">@DataLoadingLabel</div>
            }
            else if (result is null)
            {
                <div class="empty-state">Profil bilgilerini tamamlayınca karşılaştırma burada görünür.</div>
            }
            else
            {
                <div class="result-header">
                    <div>
                        <h2>@result.CountryName · @SexLabel(result.Sex)</h2>
                        <span class="badge">@result.Age yaş · @result.HeightReferenceLabel</span>
                    </div>
                    <div class="trust">
                        <strong>Veri güveni yüksek</strong>
                        <span>Hesaplama yaklaşık</span>
                        <span>@GeneratedLabel</span>
                    </div>
                </div>

                <article class="report-card">
                    <div>
                        <span class="report-kicker">Kişisel atlas raporu</span>
                        <p>@ReportLead</p>
                    </div>
                    <div class="report-actions">
                        <button class="copy-action" type="button" @onclick="CopyReportAsync">Raporu kopyala</button>
                        <button class="copy-action secondary-action" type="button" @onclick="DownloadAtlasCardAsync">Atlas kartını indir</button>
                    </div>
                </article>

                @if (copyStatus is not null)
                {
                    <div class="copy-status">@copyStatus</div>
                }

                <section class="story-panel" aria-label="Yorumlu atlas özeti">
                    @foreach (var insight in StoryInsights)
                    {
                        <article class="story-card @insight.Kind">
                            <span>@insight.Label</span>
                            <strong>@insight.Title</strong>
                            <p>@insight.Text</p>
                        </article>
                    }

                    <div class="confidence-row" aria-label="Veri güveni özeti">
                        <span class="confidence-chip strong">Boy: yüksek güven</span>
                        <span class="confidence-chip careful">BMI: referans, ideal değil</span>
                        <span class="confidence-chip approximate">Renk / el / kan: yaklaşık</span>
                    </div>
                </section>

                <div class="metric-grid">
                    <article class="metric">
                        <span>Ülke boy konumu</span>
                        <strong>%@FormatNumber(result.HeightPercentileCountry)</strong>
                        <p>@result.CountryName referansından @FormatSignedCm(result.CountryHeightDifferenceCm)</p>
                    </article>

                    <article class="metric">
                        <span>Dünya boy konumu</span>
                        <strong>%@FormatNumber(result.HeightPercentileWorld)</strong>
                        <p>Dünya referansından @FormatSignedCm(result.WorldHeightDifferenceCm)</p>
                    </article>

                    <article class="metric">
                        <span>BMI</span>
                        <strong>@FormatNumber(result.Bmi)</strong>
                        <p>@result.BmiBandLabel bandı · ideal yorumu değil</p>
                    </article>

                    <article class="metric">
                        <span>BMI referans konumu</span>
                        <strong>@PercentileOrDash(result.BmiReferencePercentile)</strong>
                        <p>@(result.BmiAgeGroup ?? "Yaş grubu yok") · @(result.BmiReferenceYear?.ToString(CultureInfo.InvariantCulture) ?? "Yıl yok")</p>
                    </article>
                </div>

                <div class="indicator-grid" aria-label="Görsel gösterge paneli">
                    <div class="indicator">
                        <div class="indicator-topline">
                            <span>Ülke boy percentile</span>
                            <strong>%@FormatNumber(result.HeightPercentileCountry)</strong>
                        </div>
                        <div class="indicator-track">
                            <div class="indicator-fill" style="@PercentileStyle(result.HeightPercentileCountry)"></div>
                            <div class="indicator-pin" style="@PercentilePinStyle(result.HeightPercentileCountry)"></div>
                        </div>
                    </div>

                    <div class="indicator">
                        <div class="indicator-topline">
                            <span>BMI referans konumu</span>
                            <strong>@PercentileOrDash(result.BmiReferencePercentile)</strong>
                        </div>
                        <div class="indicator-track bmi-track">
                            <div class="indicator-fill" style="@PercentileStyle(result.BmiReferencePercentile ?? 50)"></div>
                            <div class="indicator-pin" style="@PercentilePinStyle(result.BmiReferencePercentile ?? 50)"></div>
                        </div>
                    </div>
                </div>

                <div class="trait-summary-grid" aria-label="Eğlenceli özellik özeti">
                    <article class="trait-card" style="@TraitAccentStyle(result.EyeColor)">
                        <span>Göz rengi</span>
                        <strong>@TraitLabel(result.EyeColor)</strong>
                        <p>@TraitMeta(result.EyeColor)</p>
                    </article>

                    <article class="trait-card" style="@TraitAccentStyle(result.HairColor)">
                        <span>Saç rengi</span>
                        <strong>@TraitLabel(result.HairColor)</strong>
                        <p>@TraitMeta(result.HairColor)</p>
                    </article>

                    <article class="trait-card" style="@TraitAccentStyle(result.HairEyeCombination)">
                        <span>Saç + göz</span>
                        <strong>@TraitLabel(result.HairEyeCombination)</strong>
                        <p>@TraitMeta(result.HairEyeCombination)</p>
                    </article>

                    <article class="trait-card" style="@TraitAccentStyle(result.HandPreference)">
                        <span>El tercihi</span>
                        <strong>@TraitLabel(result.HandPreference)</strong>
                        <p>@TraitMeta(result.HandPreference)</p>
                    </article>

                    <article class="trait-card" style="@TraitAccentStyle(result.BloodGroup)">
                        <span>Kan grubu</span>
                        <strong>@TraitLabel(result.BloodGroup)</strong>
                        <p>@TraitMeta(result.BloodGroup)</p>
                    </article>
                </div>

                <div class="detail-grid">
                    <table class="comparison-table">
                        <thead>
                            <tr>
                                <th>Karşılaştırma</th>
                                <th>Referans</th>
                                <th>Fark</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Ülke ortalaması</td>
                                <td>@FormatCm(result.CountryMeanHeightCm)</td>
                                <td>@FormatSignedCm(result.CountryHeightDifferenceCm)</td>
                            </tr>
                            <tr>
                                <td>Dünya ortalaması</td>
                                <td>@FormatCm(result.WorldMeanHeightCm)</td>
                                <td>@FormatSignedCm(result.WorldHeightDifferenceCm)</td>
                            </tr>
                            <tr>
                                <td>1900 kohortu</td>
                                <td>@(result.Cohort1900MeanHeightCm is null ? "Yok" : FormatCm(result.Cohort1900MeanHeightCm.Value))</td>
                                <td>@(result.CohortDeltaVs1900Cm is null ? "Yok" : FormatSignedCm(result.CohortDeltaVs1900Cm.Value))</td>
                            </tr>
                            <tr>
                                <td>Yaklaşık ülke kilosu</td>
                                <td>@FormatOptionalKg(result.CountryEstimatedWeightKg)</td>
                                <td>@FormatSignedKg(result.CountryWeightDifferenceKg)</td>
                            </tr>
                            @if (result.WorldEstimatedWeightKg is not null)
                            {
                                <tr>
                                    <td>Yaklaşık dünya kilosu</td>
                                    <td>@FormatOptionalKg(result.WorldEstimatedWeightKg)</td>
                                    <td>@FormatSignedKg(result.WorldWeightDifferenceKg)</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="distribution">
                        <h3>BMI referans dağılımı</h3>
                        @foreach (var band in GetBmiBands(result.BmiCountryReference))
                        {
                            <div class="bar-row">
                                <span>@band.Label</span>
                                <div class="bar-track">
                                    <div class="bar-fill" style="@BandStyle(band)"></div>
                                </div>
                                <span>@FormatPercent(band.Share)</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="notes">
                    <h3>Notlar</h3>
                    <ul>
                        @foreach (var note in result.Notes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </div>
            }
        </section>
    </section>

    @if (dataset?.Sources.Count > 0)
    {
        <section class="source-panel" aria-label="Kaynaklar">
            <h2>Kaynaklar</h2>
            <ul class="source-list">
                @foreach (var source in dataset.Sources)
                {
                    <li><a href="@source.Url" target="_blank" rel="noreferrer">@source.Title</a></li>
                }
            </ul>
        </section>
    }
</main>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true,
    };

    private static readonly CultureInfo Tr = CultureInfo.GetCultureInfo("tr-TR");

    private static readonly TraitOption[] EyeColorOptions =
    [
        new("brown", "Kahverengi"),
        new("blue", "Mavi"),
        new("hazel", "Ela"),
        new("amber", "Kehribar"),
        new("green", "Yeşil"),
        new("gray", "Gri"),
    ];

    private static readonly TraitOption[] HairColorOptions =
    [
        new("black", "Siyah / koyu kahve"),
        new("brown", "Kahverengi"),
        new("blond", "Sarışın"),
        new("red", "Kızıl"),
        new("gray_white", "Gri / beyaz"),
        new("other", "Diğer / karışık"),
    ];

    private static readonly TraitOption[] HandPreferenceOptions =
    [
        new("right", "Sağlak"),
        new("left", "Solak"),
        new("ambidextrous", "İki elli"),
    ];

    private static readonly TraitOption[] BloodGroupOptions =
    [
        new("a_positive", "A Rh+"),
        new("o_positive", "0 Rh+"),
        new("b_positive", "B Rh+"),
        new("ab_positive", "AB Rh+"),
        new("a_negative", "A Rh-"),
        new("o_negative", "0 Rh-"),
        new("b_negative", "B Rh-"),
        new("ab_negative", "AB Rh-"),
    ];

    private ReferenceDataset? dataset;
    private ComparisonResult? result;
    private string? loadError;
    private string? formError;
    private string? copyStatus;
    private string? bodySceneError;
    private string? bodyScenePayloadKey;
    private string? dataStatus;
    private string selectedSceneInsight = "height";
    private ElementReference bodyCanvas;
    private IJSObjectReference? bodyAtlasModule;
    private readonly Dictionary<string, ReferenceDataset> countryDataCache = new(StringComparer.OrdinalIgnoreCase);
    private bool isAnalyzing;
    private bool bodySceneRequested;
    private bool isBodySceneStarting;

    private string selectedCountryIso = "TUR";
    private string selectedSex = "male";
    private string selectedEyeColor = "brown";
    private string selectedHairColor = "black";
    private string selectedHandPreference = "right";
    private string selectedBloodGroup = "a_positive";
    private int birthYear = 1990;
    private double heightCm = 175;
    private double weightKg = 75;

    private int MaxBirthYear => DateTime.Today.Year - 18;

    private IEnumerable<CountryReference> Countries => dataset?.Countries ?? [];

    private string BodyCanvasClass => bodySceneRequested
        ? "body-3d-canvas"
        : "body-3d-canvas idle";

    private string DataLoadingLabel => dataStatus ?? "Referans verisi yükleniyor...";

    private string GeneratedLabel => dataset is null
        ? string.Empty
        : $"Veri: {dataset.GeneratedAtUtc.ToLocalTime():dd.MM.yyyy}";

    private string ReportLead => result is null
        ? string.Empty
        : $"{HeightNarrative} {BmiNarrative} {FunLead}";

    private string FunLead => result?.HairEyeCombination is null
        ? string.Empty
        : $"Eğlenceli katmanda {result.HairEyeCombination.Label.ToLower(Tr)} yaklaşık {FormatShare(result.HairEyeCombination.Share)} seviyesinde.";

    private string HeightNarrative => result is null
        ? string.Empty
        : $"Boyun, {result.CountryName} {SexLabel(result.Sex).ToLower(Tr)} referansında yaklaşık %{FormatNumber(result.HeightPercentileCountry)} percentile konumunda; ülke ortalamasına göre {DifferencePhrase(result.CountryHeightDifferenceCm)}.";

    private string BmiNarrative => result is null
        ? string.Empty
        : $"BMI değerin {FormatNumber(result.Bmi)} ve {result.BmiBandLabel} referans bandında; bu bir ideal kilo yorumu değil, referans dağılımı okuması.";

    private string TraitNarrative => result?.HairEyeCombination is null
        ? "Eğlenceli özellikler yaklaşık veriyle yorumlanır."
        : $"{TraitLabel(result.HairColor)} saç ve {TraitLabel(result.EyeColor).ToLower(Tr)} göz kombinasyonu yaklaşık {FormatShare(result.HairEyeCombination.Share)} yaygınlık sinyali verir.";

    private IEnumerable<StoryInsight> StoryInsights
    {
        get
        {
            if (result is null)
            {
                yield break;
            }

            yield return new("Güçlü veri", HeightTone(result.HeightPercentileCountry), HeightNarrative, "strong");
            yield return new("Dikkatli yorum", "BMI bir hedef değil, referans okuması", BmiNarrative, "careful");
            yield return new("Yaklaşık sinyal", "Eğlenceli özellikler ayrı katmanda", TraitNarrative, "approximate");
        }
    }

    private string SelectedSceneInsightKicker => selectedSceneInsight switch
    {
        "height" => "Güçlü veri",
        "body" => "Referans dağılımı",
        "hair" or "eye" or "hand" or "blood" => "Yaklaşık prevalans",
        _ => "Atlas noktası",
    };

    private string SelectedSceneInsightTitle => selectedSceneInsight switch
    {
        "height" => "Boy çizgisi",
        "body" => "Gövde ve BMI",
        "hair" => "Saç rengi",
        "eye" => "Göz rengi",
        "hand" => "El tercihi",
        "blood" => "Kan grubu",
        _ => "Atlas noktası",
    };

    private string SelectedSceneInsightText => result is null
        ? string.Empty
        : selectedSceneInsight switch
        {
            "height" => $"{result.CountryName} referansında boyun {FormatCm(result.CountryMeanHeightCm)} ortalamaya göre {FormatSignedCm(result.CountryHeightDifferenceCm)} fark gösteriyor.",
            "body" => $"BMI değerin {FormatNumber(result.Bmi)}. Sahnedeki gövde ölçeği yaklaşık referans kilo farkını gösterir; ideal kilo yorumu değildir.",
            "hair" => $"{TraitLabel(result.HairColor)} saç için yaygınlık sinyali {TraitMeta(result.HairColor)}.",
            "eye" => $"{TraitLabel(result.EyeColor)} göz için yaygınlık sinyali {TraitMeta(result.EyeColor)}.",
            "hand" => $"{TraitLabel(result.HandPreference)} el tercihi için dünya geneli sinyal {TraitMeta(result.HandPreference)}.",
            "blood" => $"{TraitLabel(result.BloodGroup)} kan grubu ülkelere göre dağınık kaynaklardan yaklaşık okunur: {TraitMeta(result.BloodGroup)}.",
            _ => ReportLead,
        };

    private string SelectedSceneInsightMeta => selectedSceneInsight switch
    {
        "height" => "NCD-RisC referansı, percentile yaklaşık hesaplanır.",
        "body" => "BMI bandı sağlık önerisi veya hedef kilo değildir.",
        "hair" or "eye" or "hand" or "blood" => "Bu katman eğlenceli prevalans sinyali olarak sunulur.",
        _ => "Atlas of You",
    };

    private string SelectedSceneInsightStyle => selectedSceneInsight switch
    {
        "hair" => TraitAccentStyle(result?.HairColor),
        "eye" => TraitAccentStyle(result?.EyeColor),
        "hand" => TraitAccentStyle(result?.HandPreference),
        "blood" => TraitAccentStyle(result?.BloodGroup),
        "body" => "--trait-color:#b45309;",
        _ => "--trait-color:#0f766e;",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var manifestDataset = await Http.GetFromJsonAsync<ReferenceDataset>("data/atlas-manifest.json", JsonOptions);
            if (manifestDataset is null)
            {
                loadError = "Referans verisi okunamadı.";
                return;
            }

            await MergeFunTraitsAsync(manifestDataset);
            dataset = manifestDataset;

            selectedCountryIso = dataset.Countries.Any(item => item.Iso == "TUR")
                ? "TUR"
                : dataset.Countries.FirstOrDefault()?.Iso ?? string.Empty;

            await AnalyzeProfileAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Referans verisi yüklenemedi: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (bodySceneRequested && result is not null)
        {
            await RenderBodyAtlasAsync();
        }
    }

    private async Task RenderBodyAtlasAsync()
    {
        if (!bodySceneRequested || result is null)
        {
            return;
        }

        var currentKey = string.Join("|",
            selectedCountryIso,
            selectedSex,
            heightCm.ToString("0.###", CultureInfo.InvariantCulture),
            weightKg.ToString("0.###", CultureInfo.InvariantCulture),
            result.CountryMeanHeightCm.ToString("0.###", CultureInfo.InvariantCulture),
            (result.CountryEstimatedWeightKg ?? weightKg).ToString("0.###", CultureInfo.InvariantCulture),
            result.HairColor?.Value,
            result.EyeColor?.Value,
            result.HandPreference?.Value,
            result.BloodGroup?.Value);

        if (currentKey == bodyScenePayloadKey && bodySceneError is null)
        {
            return;
        }

        bodyScenePayloadKey = currentKey;

        try
        {
            bodyAtlasModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/bodyAtlas3d.js");
            await bodyAtlasModule.InvokeVoidAsync("renderBodyAtlas3d", bodyCanvas, new
            {
                selectedSex,
                countryName = result.CountryName,
                userHeightCm = heightCm,
                averageHeightCm = result.CountryMeanHeightCm,
                userWeightKg = weightKg,
                referenceWeightKg = result.CountryEstimatedWeightKg ?? weightKg,
                heightDiffCm = result.CountryHeightDifferenceCm,
                weightDiffKg = result.CountryWeightDifferenceKg,
                hairColor = TraitColor(result.HairColor, "#181512"),
                eyeColor = TraitColor(result.EyeColor, "#5a3825"),
                handPreference = result.HandPreference?.Value ?? selectedHandPreference,
                bloodColor = TraitColor(result.BloodGroup, "#a43d55"),
                bloodLabel = result.BloodGroup?.Label ?? "-",
            });

            if (bodySceneError is not null)
            {
                bodySceneError = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            const string message = "3D sahne yüklenemedi. Karşılaştırma verileri yine kullanılabilir.";
            if (bodySceneError != message)
            {
                bodySceneError = message;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task StartBodySceneAsync()
    {
        if (result is null)
        {
            return;
        }

        bodySceneRequested = true;
        isBodySceneStarting = true;
        bodyScenePayloadKey = null;
        bodySceneError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await RenderBodyAtlasAsync();
        }
        finally
        {
            isBodySceneStarting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EnsureBodySceneAsync()
    {
        if (!bodySceneRequested)
        {
            await StartBodySceneAsync();
            return;
        }

        await RenderBodyAtlasAsync();
    }

    private async Task MergeFunTraitsAsync(ReferenceDataset target)
    {
        ReferenceDataset? funTraits;
        try
        {
            funTraits = await Http.GetFromJsonAsync<ReferenceDataset>("data/fun-traits.json", JsonOptions);
        }
        catch
        {
            target.Notes.Add("Eğlenceli özellik verisi yüklenemediğinde boy ve BMI karşılaştırması çalışmaya devam eder.");
            return;
        }

        if (funTraits is null)
        {
            return;
        }

        target.TraitReferences.AddRange(funTraits.TraitReferences);

        foreach (var source in funTraits.Sources)
        {
            if (!target.Sources.Any(item => item.Id == source.Id))
            {
                target.Sources.Add(source);
            }
        }

        foreach (var note in funTraits.Notes)
        {
            if (!target.Notes.Contains(note, StringComparer.Ordinal))
            {
                target.Notes.Add(note);
            }
        }
    }

    private async Task AnalyzeProfileAsync()
    {
        if (dataset is null)
        {
            return;
        }

        formError = ValidateForm();
        if (formError is not null)
        {
            result = null;
            bodyScenePayloadKey = null;
            return;
        }

        try
        {
            isAnalyzing = true;
            dataStatus = "Seçili ülke referansı yükleniyor...";
            var runtimeDataset = await BuildRuntimeDatasetAsync(selectedCountryIso);
            result = AtlasCalculator.Analyze(
                runtimeDataset,
                new ProfileInput
                {
                    CountryIso = selectedCountryIso,
                    Sex = selectedSex,
                    BirthYear = birthYear,
                    HeightCm = heightCm,
                    WeightKg = weightKg,
                    EyeColor = selectedEyeColor,
                    HairColor = selectedHairColor,
                    HandPreference = selectedHandPreference,
                    BloodGroup = selectedBloodGroup,
                },
                DateOnly.FromDateTime(DateTime.Today));
            copyStatus = null;
            bodySceneError = null;
            bodyScenePayloadKey = null;
            dataStatus = null;
        }
        catch (Exception ex)
        {
            result = null;
            formError = ex.Message;
            bodyScenePayloadKey = null;
            dataStatus = null;
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task<ReferenceDataset> BuildRuntimeDatasetAsync(string countryIso)
    {
        if (dataset is null)
        {
            throw new InvalidOperationException("Referans manifesti yüklenmedi.");
        }

        var selectedCountryData = await LoadCountryDatasetAsync(countryIso);
        var dataFiles = new List<ReferenceDataset> { selectedCountryData };
        if (!StringComparer.OrdinalIgnoreCase.Equals(countryIso, "WORLD"))
        {
            dataFiles.Add(await LoadCountryDatasetAsync("WORLD"));
        }

        return new ReferenceDataset
        {
            SchemaVersion = dataset.SchemaVersion,
            GeneratedAtUtc = dataset.GeneratedAtUtc,
            Countries = dataset.Countries,
            HeightCohorts = dataFiles.SelectMany(item => item.HeightCohorts).ToList(),
            YoungAdultHeight = dataFiles.SelectMany(item => item.YoungAdultHeight).ToList(),
            BmiReferences = dataFiles.SelectMany(item => item.BmiReferences).ToList(),
            TraitReferences = dataset.TraitReferences,
            Sources = dataset.Sources,
            Notes = dataset.Notes,
        };
    }

    private async Task<ReferenceDataset> LoadCountryDatasetAsync(string countryIso)
    {
        if (countryDataCache.TryGetValue(countryIso, out var cached))
        {
            return cached;
        }

        var payload = await Http.GetFromJsonAsync<ReferenceDataset>(
            $"data/atlas-country/{Uri.EscapeDataString(countryIso)}.json",
            JsonOptions);
        if (payload is null)
        {
            throw new InvalidOperationException($"{countryIso} referans verisi okunamadı.");
        }

        countryDataCache[countryIso] = payload;
        return payload;
    }

    private void SetSceneInsight(string insight)
    {
        selectedSceneInsight = insight;
    }

    private string SceneHotspotClass(string insight)
    {
        var active = selectedSceneInsight == insight ? " active" : string.Empty;
        return $"scene-hotspot {insight}{active}";
    }

    private string? ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(selectedCountryIso))
        {
            return "Ülke seçimi gerekli.";
        }

        if (birthYear < 1896 || birthYear > MaxBirthYear)
        {
            return $"Doğum yılı 1896 ile {MaxBirthYear} arasında olmalı.";
        }

        if (heightCm is < 120 or > 230)
        {
            return "Boy değeri 120-230 cm aralığında olmalı.";
        }

        if (weightKg is < 35 or > 250)
        {
            return "Kilo değeri 35-250 kg aralığında olmalı.";
        }

        return null;
    }

    private static string SexLabel(string sex) => sex == "male" ? "Erkek" : "Kadın";

    private static string FormatNumber(double value) => value.ToString("0.0", Tr);

    private static string FormatCm(double value) => $"{FormatNumber(value)} cm";

    private static string FormatKg(double value) => $"{FormatNumber(value)} kg";

    private static string FormatOptionalKg(double? value) => value is null ? "Yok" : FormatKg(value.Value);

    private static string FormatSignedCm(double value)
    {
        var sign = value > 0 ? "+" : string.Empty;
        return $"{sign}{FormatNumber(value)} cm";
    }

    private static string FormatSignedKg(double? value)
    {
        if (value is null)
        {
            return "Yok";
        }

        var sign = value > 0 ? "+" : string.Empty;
        return $"{sign}{FormatNumber(value.Value)} kg";
    }

    private static string PercentileOrDash(double? value) => value is null ? "Yok" : $"%{FormatNumber(value.Value)}";

    private static string FormatPercent(double share) => $"%{(share * 100).ToString("0", Tr)}";

    private static string FormatShare(double share)
    {
        var percent = share * 100;
        var format = percent < 1 ? "0.##" : "0.#";
        return $"%{percent.ToString(format, Tr)}";
    }

    private static string TraitLabel(TraitComparison? trait) => trait?.Label ?? "Yok";

    private static string TraitMeta(TraitComparison? trait)
    {
        if (trait is null)
        {
            return "Yaklaşık veri yok";
        }

        var oneIn = trait.OneIn is > 1 && trait.Share < 0.2
            ? $" · yaklaşık 1/{trait.OneIn}"
            : string.Empty;
        return $"{FormatShare(trait.Share)} · {trait.RarityLabel}{oneIn} · {ConfidenceLabel(trait.Confidence)}";
    }

    private static string ConfidenceLabel(string confidence)
    {
        return confidence switch
        {
            "orta" => "orta güven",
            "dusuk" => "düşük güven",
            "yüksek" or "yuksek" => "yüksek güven",
            _ => "yaklaşık",
        };
    }

    private static string TraitAccentStyle(TraitComparison? trait)
    {
        var color = TraitColor(trait, "#0f766e");
        return $"--trait-color:{color};";
    }

    private static string TraitColor(TraitComparison? trait, string fallback)
    {
        return string.IsNullOrWhiteSpace(trait?.Color)
            ? fallback
            : trait.Color;
    }

    private static string PercentileStyle(double percentile)
    {
        return $"--percentile:{ClampPercentile(percentile).ToString("0.###", CultureInfo.InvariantCulture)}%;";
    }

    private static string PercentilePinStyle(double percentile)
    {
        return $"--pin:{ClampPercentile(percentile).ToString("0.###", CultureInfo.InvariantCulture)}%;";
    }

    private static string BandStyle(DistributionBand band)
    {
        return $"--share:{(band.Share * 100).ToString("0.###", CultureInfo.InvariantCulture)}%;--bar-color:{band.Color};";
    }

    private static string DifferencePhrase(double difference)
    {
        if (Math.Abs(difference) < 0.5)
        {
            return "ortalama ile neredeyse aynı çizgide";
        }

        var absolute = FormatCm(Math.Abs(difference));
        return difference > 0
            ? $"ortalamanın {FormatSignedCm(difference)} üstünde"
            : $"ortalamanın {absolute} altında";
    }

    private static string HeightTone(double percentile)
    {
        if (percentile < 25)
        {
            return "Boyun referansın alt çeyreğine yakın";
        }

        if (percentile > 75)
        {
            return "Boyun referansın üst çeyreğine yakın";
        }

        return "Boyun referansın orta bandında";
    }

    private object BuildAtlasCardPayload()
    {
        if (result is null)
        {
            return new { };
        }

        return new
        {
            title = "Atlas of You",
            version = "v0.5.0",
            subtitle = $"{result.CountryName} · {SexLabel(result.Sex)} · {result.Age} yaş",
            narrative = ReportLead,
            fileName = $"atlas-of-you-{result.CountryIso.ToLowerInvariant()}-{result.Sex}-{DateTime.Today:yyyyMMdd}.png",
            metrics = new[]
            {
                new { label = "Ülke boy konumu", value = $"%{FormatNumber(result.HeightPercentileCountry)}", detail = FormatSignedCm(result.CountryHeightDifferenceCm), color = "#0f766e" },
                new { label = "Dünya boy konumu", value = $"%{FormatNumber(result.HeightPercentileWorld)}", detail = FormatSignedCm(result.WorldHeightDifferenceCm), color = "#285e8f" },
                new { label = "BMI", value = FormatNumber(result.Bmi), detail = $"{result.BmiBandLabel} · ideal değil", color = "#b45309" },
                new { label = "BMI referansı", value = PercentileOrDash(result.BmiReferencePercentile), detail = result.BmiAgeGroup ?? "Yaş grubu yok", color = "#a43d55" },
            },
            traits = new[]
            {
                new { label = "Saç", value = TraitLabel(result.HairColor), detail = TraitMeta(result.HairColor), color = TraitColor(result.HairColor, "#181512") },
                new { label = "Göz", value = TraitLabel(result.EyeColor), detail = TraitMeta(result.EyeColor), color = TraitColor(result.EyeColor, "#5a3825") },
                new { label = "El", value = TraitLabel(result.HandPreference), detail = TraitMeta(result.HandPreference), color = TraitColor(result.HandPreference, "#0f766e") },
                new { label = "Kan", value = TraitLabel(result.BloodGroup), detail = TraitMeta(result.BloodGroup), color = TraitColor(result.BloodGroup, "#a43d55") },
            },
            notes = new[]
            {
                "Boy ve BMI güçlü referans veriyle, yaklaşık hesaplama diliyle sunulur.",
                "Saç, göz, el tercihi ve kan grubu eğlenceli prevalans sinyalidir.",
                "Girdiğin bilgiler tarayıcıda kalır.",
            },
        };
    }

    private string BuildReportText()
    {
        if (result is null)
        {
            return string.Empty;
        }

        return string.Join(Environment.NewLine,
            "Atlas of You - Kişisel Referans Raporu",
            $"{result.CountryName} / {SexLabel(result.Sex)} / {result.Age} yaş",
            $"Boy: {FormatCm(heightCm)} ({result.CountryName} referansından {FormatSignedCm(result.CountryHeightDifferenceCm)}, dünya referansından {FormatSignedCm(result.WorldHeightDifferenceCm)})",
            $"BMI: {FormatNumber(result.Bmi)} ({result.BmiBandLabel} bandı, ideal kilo yorumu değildir)",
            $"Yaklaşık referans kilo farkı: {FormatSignedKg(result.CountryWeightDifferenceKg)}",
            $"Göz / saç: {TraitLabel(result.EyeColor)} / {TraitLabel(result.HairColor)}",
            $"Saç + göz nadirliği: {TraitMeta(result.HairEyeCombination)}",
            $"El tercihi / kan grubu: {TraitLabel(result.HandPreference)} / {TraitLabel(result.BloodGroup)}",
            $"Veri güveni: yüksek; percentile ve kilo görseli yaklaşık hesaplanır.");
    }

    private async Task CopyReportAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", BuildReportText());
            copyStatus = "Rapor panoya kopyalandı.";
        }
        catch
        {
            copyStatus = "Tarayıcı pano erişimine izin vermedi.";
        }
    }

    private async Task DownloadAtlasCardAsync()
    {
        if (result is null)
        {
            return;
        }

        try
        {
            await EnsureBodySceneAsync();
            if (bodyAtlasModule is null)
            {
                throw new InvalidOperationException("3D sahne hazır değil.");
            }

            await bodyAtlasModule.InvokeVoidAsync("downloadAtlasCard", bodyCanvas, BuildAtlasCardPayload());
            copyStatus = "Atlas kartı PNG olarak indirildi.";
        }
        catch
        {
            copyStatus = "Atlas kartı oluşturulamadı. Tarayıcı 3D sahneyi hazır etmemiş olabilir.";
        }
    }

    private static double ClampPercentile(double percentile) => Math.Clamp(percentile, 0, 100);

    private static IEnumerable<DistributionBand> GetBmiBands(BmiReference? reference)
    {
        if (reference is null)
        {
            yield break;
        }

        yield return new("18.5 altı", reference.Under185, "#285e8f");
        yield return new("18.5-20", reference.From185To20, "#0f766e");
        yield return new("20-25", reference.From20To25, "#4d7c0f");
        yield return new("25-30", reference.From25To30, "#b45309");
        yield return new("30-35", reference.From30To35, "#a43d55");
        yield return new("35-40", reference.From35To40, "#7c2d12");
        yield return new("40+", reference.Over40, "#4c1d95");
    }

    public async ValueTask DisposeAsync()
    {
        if (bodyAtlasModule is not null)
        {
            try
            {
                await bodyAtlasModule.InvokeVoidAsync("disposeBodyAtlas3d", bodyCanvas);
                await bodyAtlasModule.DisposeAsync();
            }
            catch
            {
                // The page may be unloading while the WebGL context is already gone.
            }
        }
    }

    private sealed record DistributionBand(string Label, double Share, string Color);

    private sealed record StoryInsight(string Label, string Title, string Text, string Kind);

    private sealed record TraitOption(string Value, string Label);
}
